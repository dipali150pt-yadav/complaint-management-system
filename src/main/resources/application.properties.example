# ========================================
# COMPLAINT MANAGEMENT SYSTEM - AI CONFIGURATION
# ========================================
# Copy this file to 'application.properties' and configure your settings

spring.application.name=complaintsystem

spring.servlet.multipart.enabled=true
spring.servlet.multipart.max-file-size=10MB
spring.servlet.multipart.max-request-size=10MB

# ========================================
# DATABASE CONFIGURATION
# ========================================
spring.datasource.url=jdbc:mysql://localhost:3306/complaintdb
spring.datasource.username=root
spring.datasource.password=YOUR_MYSQL_PASSWORD

spring.jpa.hibernate.ddl-auto=update
spring.jpa.show-sql=true
spring.jpa.database-platform=org.hibernate.dialect.MySQL8Dialect

# ========================================
# AI SERVICE CONFIGURATION
# ========================================

# AI Provider Selection
# Options: 'openai', 'google', 'local'
# 
# RECOMMENDED SETUP:
# 1. Start with 'local' (no API key needed, basic functionality)
# 2. Upgrade to 'openai' for production (best accuracy)
# 3. Use 'google' if you prefer Google Cloud ecosystem
ai.provider=local

# ---------------------------------------
# OPENAI CONFIGURATION (Recommended)
# ---------------------------------------
# Sign up at: https://platform.openai.com/
# Create API key at: https://platform.openai.com/api-keys
# Pricing: ~$0.01 per image analysis (GPT-4o-mini)
#
# Example: openai.api.key=sk-proj-abc123xyz...
openai.api.key=YOUR_OPENAI_API_KEY

# ---------------------------------------
# GOOGLE CLOUD VISION CONFIGURATION
# ---------------------------------------
# Setup guide: https://cloud.google.com/vision/docs/setup
# Create project: https://console.cloud.google.com/
# Enable Vision API: https://console.cloud.google.com/apis/library/vision.googleapis.com
# Create credentials: https://console.cloud.google.com/apis/credentials
# Pricing: Free for first 1000 requests/month
#
# Example: google.cloud.vision.api.key=AIza...
google.cloud.vision.api.key=YOUR_GOOGLE_CLOUD_API_KEY

# ========================================
# APPLICATION SETTINGS
# ========================================

# Upload directory for complaint images
app.upload.dir=${user.dir}/uploads

# Enable/disable AI image analysis
app.ai.enabled=true

# AI confidence threshold (0.0 to 1.0)
# Complaints below this threshold will be flagged for manual review
# Recommended: 0.6 (60%)
app.ai.confidence.threshold=0.6

# Automatically assign department based on AI classification
app.ai.auto.assign=true

# ========================================
# LOGGING CONFIGURATION
# ========================================
logging.level.com.cms.complaintsystem=INFO
logging.level.com.cms.complaintsystem.service.ImageAnalysisService=DEBUG
logging.level.com.cms.complaintsystem.service.AIService=DEBUG

# ========================================
# SERVER CONFIGURATION
# ========================================
server.port=8080
server.servlet.session.timeout=30m
